# =============================================================================
# 文件: systemd/cmc-frontend.service
# 用途: 用 systemd 管 Streamlit 前端进程
# 安装位置: /etc/systemd/system/cmc-frontend.service
# =============================================================================

[Unit]
Description=CMC Inventory Frontend (Streamlit)
Documentation=https://github.com/qingcheng81/cmc-inventory
After=network-online.target cmc-backend.service
Wants=network-online.target cmc-backend.service

[Service]
Type=simple
User=prometheus
Group=prometheus
WorkingDirectory=/opt/cmc-inventory/frontend
# 端口由 .env 中的 FRONTEND_PORT 控制(改 .env 即可,不动 unit)
# 注意:不要再用 Environment=FRONTEND_PORT=... 兜底 ——
#       systemd 中 Environment= 会覆盖 EnvironmentFile= 中的同名变量,导致 .env 失效
EnvironmentFile=/opt/cmc-inventory/.env

ExecStart=/opt/cmc-inventory/frontend/.venv/bin/streamlit run app.py \
    --server.port=${FRONTEND_PORT} \
    --server.address=0.0.0.0 \
    --server.headless=true \
    --browser.gatherUsageStats=false

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
