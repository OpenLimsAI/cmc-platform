# /etc/flex2-ingest.env
# FLEX2 Stage 1 采集配置。修改后需 systemctl daemon-reload 不是必须，但重跑一次 --dry-run 确认。

# ---- 仪器标识 ----
# Analyzer ID 出现在每个文件名里，是区分多台机器的唯一标识。
# 将来接第二台 FLEX2，复制这个 env 文件改这一项即可，脚本不用动。
FLEX2_ANALYZER_ID=T281240040C
# 机器名 = NAS 上按设备预建的目录名（Daily/ 下那一层）
FLEX2_MACHINE_NAME=T281240040C_Nova

# ---- 挂载点 ----
FLEX2_SRC_MOUNT=/mnt/flex2
# NAS 共享根 TTLab_Backups 的挂载点。归档沿用既有多设备约定：
#   数据 → Daily/<机器名>/（Results 月度快照+逐次、Database 每晚备份；Report 预建但不写）
#   记账 → NAS 根级 Checksums/<机器名>/、Logs/<机器名>/、State/<机器名>_backup_state.json
FLEX2_NAS_MOUNT=/mnt/ttlab-backups

# ---- 采集范围 ----
# 月度文件回溯月数。1 = 当月 + 上月。
# 保留上月是为了跨月边界：8/1 凌晨跑时，7 月最后几条可能还没定稿。
FLEX2_MONTHS_BACK=1

# ---- 健康告警 ----
# Database 备份每晚 23:30 固定跑，与做不做样品无关，是最好的健康信号。
# 注意：不要用"样品数据多久没更新"来告警 —— 这台仪器会真的连续停机好几周，
# 那样只会天天误报，最后没人看告警。
FLEX2_DB_STALE_HOURS=36

# 告警命令，调用方式：$FLEX2_ALERT_CMD <级别> <消息>
# 级别取值：WARNING / ERROR / CRITICAL
# 留空则只写日志（上线前务必配好，否则等于没有告警）
FLEX2_ALERT_CMD=/usr/local/bin/flex2-alert.sh

# ---- 读取稳定性 ----
# 月度 CSV 整月都在被追加，读取前后 stat 不一致则重试，避免读到半截行
FLEX2_STABLE_RETRIES=4
FLEX2_STABLE_WAIT_SEC=3

# ---- 本地状态副本目录（NAS 不可达时仍留痕迹）----
FLEX2_LOCAL_STATE_DIR=/var/lib/flex2-ingest
