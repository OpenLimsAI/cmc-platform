[Unit]
Description=Run FLEX2 ingest (夜间抓 Database 备份 + 白天两趟补抓月度 CSV)

[Timer]
# Nova 23:30 做数据库备份，01:00 跑，避开写入窗口（这一趟负责抓 Database 备份）
OnCalendar=*-*-* 01:00:00
# 白天两趟：排在 Vi-CELL 快跑归档(11:45 / 18:00)之后 10 分钟，
# 两台设备错开、互不抢 NAS；再过 10 分钟由 vicell-etl / nova-etl 统一入库
# （12:05 / 18:20）。改这里要同步看那三个 timer，别打乱先后顺序。
OnCalendar=*-*-* 11:55:00
OnCalendar=*-*-* 18:10:00
# 必须为 0：本机各 timer 靠 10 分钟错峰保证「先备份、后 ETL」的顺序，
# 一旦加随机延迟（曾是 300s）就可能让 ETL 跑到备份前面。
RandomizedDelaySec=0
Persistent=true

[Install]
WantedBy=timers.target
