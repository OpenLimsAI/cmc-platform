[Unit]
Description=FLEX2 Stage 1 ingest and verify (cmc-instrument-ingest)
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/flex2 /mnt/ttlab-backups
# 本单元失败时触发统一告警出口（现在只写 journald；
# 配上 /etc/instrument-ingest/alert.env 的 INGEST_ALERT_WEBHOOK 即自动外呼）
OnFailure=instrument-alert@%n.service

[Service]
Type=oneshot
User=flex2ingest
Group=flex2ingest
EnvironmentFile=/etc/flex2-ingest.env
ExecStart=/usr/bin/python3 /opt/cmc-instrument-ingest/flex2/flex2_ingest.py
TimeoutStartSec=1800
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/flex2-ingest /mnt/ttlab-backups
