<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.qingcheng.cmc-lims.frontend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/pnpm</string>
        <string>dev</string>
        <string>--port</string>
        <string>3000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/qingcheng/code/cmc-rd-lims-dashboard/frontend</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/qingcheng/Library/Logs/cmc-rd-lims-dashboard/frontend.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/qingcheng/Library/Logs/cmc-rd-lims-dashboard/frontend.err.log</string>
</dict>
</plist>
