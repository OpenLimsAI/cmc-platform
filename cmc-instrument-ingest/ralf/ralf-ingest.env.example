# RALF（Bioengineering 发酵工作站）Stage 1 数据库备份 —— 环境变量样例
# 复制成 /etc/instrument-ingest/ralf-<机器名>.env 后按实际填写。
# ⚠️ 只提交 .example；真配置含 IP/凭据路径，不进仓库（.gitignore 已挡 *.env）。
# ⚠️ 本源是本库第一个「数据库型」源（用 mysqldump，不是复制文件），与文件型仪器
#    的规范差异见 docs/source-survey-ralf.md §3。
# ⚠️ 采集脚本 ralf_ingest.py 尚未落地（待联网勘察 + 实测后按 §11 清单实现）。
#    本样例先把「每台工作站一份配置」的配置面定下来，回公司照它逐台填。

# ------------------------------------------------------------------
# 每台工作站一份本文件；多台 = 多份 ralf-<机器名>.env（脚本遍历跑）
# ------------------------------------------------------------------

# 机器名 = <Windows 主机名>_Bioengineering。一台一个，贯穿 NAS 所有目录，
# 一旦确立永不改名（改名 = NAS 上历史断成两截）。主机名用 nmblookup -A <ip> 取。
RALF_MACHINE_NAME=WSXXXX_Bioengineering

# ---- 源数据库（MySQL 4.1，只读）----
RALF_DB_HOST=10.0.13.58
RALF_DB_PORT=3306

# 只读账号凭据：用 MySQL 的 defaults-extra-file（[client] 段写 user/password），
# 文件 chmod 600、chown root。**用配置文件而不是命令行 -p**——命令行密码会
# 出现在 ps 进程列表里泄露。账号必须只读（etl_reader / instrument_reader），
# 绝不用 root 或发酵系统自己的写账号 user。
RALF_DB_DEFAULTS_FILE=/etc/instrument-ingest/ralf-WSXXXX.cnf

# 冷/热库识别前缀：脚本 SHOW DATABASES 后按前缀自动分类，
# 这样不同工作站罐号不同（b8/b9 vs b1/b2…）也无需改配置。
RALF_COLD_DB_PREFIX=db_archive     # 归档库（历史，大）→ 月度全量 dump
RALF_HOT_DB_PREFIX=pbh             # 实时库（近 12 个月，小）→ 周度全量 dump
RALF_EXCLUDE_DBS=mysql,test,information_schema,performance_schema

# ---- NAS 归档区 + 本地暂存 ----
RALF_NAS_MOUNT=/mnt/ttlab-backups
# 本地暂存（先落地校验，再送 NAS）+ 状态/心跳副本，需 chown 给运行用户
RALF_STAGE_DIR=/var/lib/ralf-ingest

# ---- 频率与保留（GFS 祖-父-子；详见 docs/source-survey-ralf.md §2 与桌面备份策略）----
# 冷库（月变）：每月一次；NAS 留 6 份月备 + 每年 1 份长期
RALF_COLD_KEEP_MONTHLY=6
RALF_COLD_KEEP_YEARLY=10
# 热库（周变）：每周一次；NAS 留 8~12 份
RALF_HOT_KEEP_WEEKLY=12

# ---- 告警与心跳（复用库内统一出口 tools/ingest-alert.sh）----
RALF_ALERT_CMD=/opt/cmc-instrument-ingest/tools/ingest-alert.sh
# 外呼 webhook 留空 = 只进 journald；填上即刻生效。也可放 /etc/instrument-ingest/alert.env
INGEST_ALERT_WEBHOOK=
RALF_ALERTS_ENABLED=1
RALF_HEARTBEAT_ENABLED=1
# 健康信号用「dump 任务有没有按时跑」，不用「业务数据陈旧」（归档月变，会误报）。
# 热库每周一次 = 间隔 168 小时；超过 3 倍（504h）没成功算异常。
RALF_EXPECTED_INTERVAL_HOURS=168
RALF_MAX_SILENCE_HOURS=504
RALF_ALERT_MAX_EXTERNAL=20
