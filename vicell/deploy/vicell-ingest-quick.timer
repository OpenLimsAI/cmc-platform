[Unit]
Description=Run Vi-CELL XR ingest twice daily (白天快跑，不含图片)

[Timer]
# 白天两趟，只归档 Data/Export（几秒完成），目的是把样品 txt 尽快送到 NAS，
# 让下游 rd-vicell-etl 当天就能入库——原先每天只有 02:30 一趟，
# 白天测的样品要等到次日才进库（最坏约 43 小时）。
# 每趟之后约 1 小时跑 ETL：11:45 → 12:45、18:00 → 19:00。
# 图片不在这里归档，由 02:30 的 vicell-ingest.timer（完整版）负责，原因见 .service 注释。
OnCalendar=*-*-* 11:45:00
OnCalendar=*-*-* 18:00:00
RandomizedDelaySec=300
# 关机/休眠错过的补跑（仪器数据不会自己消失，补跑总比漏掉好）
Persistent=true

[Install]
WantedBy=timers.target
