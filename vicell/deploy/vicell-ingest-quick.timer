[Unit]
Description=Run Vi-CELL XR ingest twice daily (白天快跑，不含图片)

[Timer]
# 白天两趟，只归档 Data/Export（几秒完成），目的是把样品 txt 尽快送到 NAS，
# 让下游 rd-vicell-etl 当天就能入库——原先每天只有 02:30 一趟，
# 白天测的样品要等到次日才进库（最坏约 43 小时）。
# 图片不在这里归档，由 02:30 的 vicell-ingest.timer（完整版）负责，原因见 .service 注释。
#
# 每轮三步，各错开 10 分钟（本机两台设备 + 统一入库）：
#   11:45 本单元(Vi-CELL) → 11:55 flex2-ingest → 12:05 vicell-etl / nova-etl
#   18:00 本单元(Vi-CELL) → 18:10 flex2-ingest → 18:20 vicell-etl / nova-etl
OnCalendar=*-*-* 11:45:00
OnCalendar=*-*-* 18:00:00
# 必须为 0：顺序靠上面的 10 分钟错峰保证，加随机延迟会打乱先后。
RandomizedDelaySec=0
# 关机/休眠错过的补跑（仪器数据不会自己消失，补跑总比漏掉好）
Persistent=true

[Install]
WantedBy=timers.target
