[Unit]
Description=Run Vi-CELL XR ingest daily

[Timer]
# 这是**完整**的一趟：Data + Export + 图片，每天凌晨跑一次。
# 排在 02:30，避开 FLEX2 的 01:00 那趟，两台不抢 NAS 带宽；
# 也避开白天——图片段读仪器工作站共享，白天仪器在用时会撞上占用。
# 白天另有 vicell-ingest-quick.timer（11:45 / 18:00）只跑 Data/Export，
# 负责把样品 txt 尽快送到 NAS 供下游 ETL 当天入库。两者共用同一份 state。
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=300
# 关机/休眠错过的补跑（仪器数据不会自己消失，补跑总比漏掉好）
Persistent=true

[Install]
WantedBy=timers.target
