# Vi-CELL XR Stage 1 归档 —— 环境变量样例
# 复制成 /etc/instrument-ingest/vicell-ingest.env 后按实际填写。
# ⚠️ 本文件只提交 .example，真文件含路径/告警配置，不进仓库（.gitignore 已挡 *.env）。

# 机器名：沿用 NAS Daily/ 下既有目录名，改了会导致归档落到新目录
VICELL_MACHINE_NAME=C4V61257XH_ViCell

# 源挂载点（Vi-Cell$ 只读挂载）与 NAS 归档区挂载点
VICELL_SRC_MOUNT=/mnt/vicell
VICELL_NAS_MOUNT=/mnt/ttlab-backups

# 是否归档图片（1/0）。首次回补量大，可先设 0 把 Data/Export 落袋，再单独开
VICELL_ARCHIVE_IMAGES=1

# 单次最多归档多少个图片目录（0=不限）。首次回补建议设成 200 左右分多次跑，
# 免得一次占满维护窗口；跑完一轮 state 已记账，下次自动接着走
VICELL_IMAGE_DIR_LIMIT=0

# 每样品期望图片数（实测恒为 50）。对不上只告警、照常归档
VICELL_EXPECTED_TIF=50

# 告警命令，会以 "<级别>" "<消息>" 两个参数调用；留空则只写日志
VICELL_ALERT_CMD=

# 源文件读取稳定性重试（防止读到仪器正在写的半截文件）
VICELL_STABLE_RETRIES=4
VICELL_STABLE_WAIT_SEC=3

# 本地状态副本目录（NAS 不可达时仍留痕），需 chown 给运行用户
VICELL_LOCAL_STATE_DIR=/var/lib/vicell-ingest

# 是否采集源端原始文件 metadata（含 Windows 创建时间）。1=采集，0=关闭。
# 关闭后行为与 v1.2.1 完全一致（向后兼容）。采集失败绝不阻断备份。
# 见 docs/DATA_INTEGRITY_METADATA_DESIGN.md
VICELL_COLLECT_METADATA=1
