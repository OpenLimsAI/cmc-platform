# 复制本文件为 .env 并填好连接串。两个只读连接、同一实例、同一只读账号 lims_reader，只换库名。
# 别用写账号 lucullus_etl / vicell_etl。

# 工艺曲线（Lucullus，必填）：只读 cmc_rd
RAW_DATABASE_URL=postgresql+asyncpg://lims_reader:<口令>@localhost:5432/cmc_rd

# 细胞生长曲线（Vi-CELL，选填）：只读 cmc_analytics。留空则细胞视图不可用，工艺曲线不受影响
ANALYTICS_DATABASE_URL=postgresql+asyncpg://lims_reader:<口令>@localhost:5432/cmc_analytics

# 走 SSH 隧道读 Linux 全量真数据时（一条隧道服务两个库）：
#   ssh -N -L 15432:localhost:5432 -p 13568 prometheus@172.19.0.105
#   把上面两行的 localhost:5432 改成 localhost:15432 即可。

APP_ENV=dev
# 前端开发地址，逗号分隔，用于 CORS
DEV_EXTRA_ORIGINS=http://localhost:5170
