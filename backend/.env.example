# QAP 后端环境变量模板。复制为 .env 并按需修改（.env 已被 gitignore）。
# 分析读取 cmc_analytics。应用的 read-only 设置不能替代数据库最小权限账号。
# XLSX 当前仅结构预览，无正式写入连接；不要将真实凭据提交 Git。

# 数据库（只读消费 cmc_analytics；rd_pg 实例，本机 Docker 映射到 5432）
QAP_DB_HOST=127.0.0.1
QAP_DB_PORT=5432
QAP_DB_NAME=cmc_analytics
# 生产环境改用中台分配的只读角色（如 lims_reader），不要用写账号/超级用户
QAP_DB_USER=lims_reader
QAP_DB_PASSWORD=__set_me__

# Phase 1 仅 R&D（白皮书：GMP 走 snap_gmp，QC 未就绪）
# QAP_SOURCE_SYSTEMS=["rd_samplemanager"]

# 本机未配置身份时仅保留只读开发页面，Excel 预览始终要求 MDM 验签和角色授权。
QAP_ENVIRONMENT=development
QAP_AUTH_REQUIRED=false
QAP_JWT_ALGORITHM=HS256
# 与 MDM 一致的验签材料须通过安全方式配置；不要复制示例值充当真实密钥。
# QAP_JWT_SECRET_KEY=
# RS256 时配置 MDM RSA 公钥文件：
# QAP_JWT_PUBLIC_KEY_PATH=
# 负责人已确认：QC综合可查看/导入，QA放行仅查看；当前导入仅开放结构预览。
# MDM角色码，不是中文显示名；空数组仍可用于显式关闭授权。
QAP_READ_ROLES=["QAP_QC_GENERAL","QAP_QA_RELEASE"]
QAP_IMPORT_PREVIEW_ROLES=["QAP_QC_GENERAL"]
# 最终正式环境必须设置 QAP_ENVIRONMENT=production、QAP_AUTH_REQUIRED=true；
# 必需验签配置缺失或无效时服务启动失败。API key 不能替代 MDM 身份。
