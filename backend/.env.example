# 复制本文件为 .env 并填好连接串。两个只读连接、同一实例、同一只读账号 lims_reader，只换库名。
# 别用写账号 lucullus_etl / vicell_etl。

# 工艺曲线（Lucullus，必填）：只读 cmc_rd
RAW_DATABASE_URL=postgresql+asyncpg://lims_reader:<口令>@localhost:5432/cmc_rd

# 细胞生长曲线（Vi-CELL，选填）：只读 cmc_analytics。留空则细胞视图不可用，工艺曲线不受影响
ANALYTICS_DATABASE_URL=postgresql+asyncpg://lims_reader:<口令>@localhost:5432/cmc_analytics

# 人工录入（渗透压等）写库：cmc_analytics 写账号 usp_writer（只对 manual.sample_result 有追加权限，
# 密码由运维 ALTER ROLE 设置）。留空则「渗透压录入」页不可用，其余不受影响。
MANUAL_WRITE_DATABASE_URL=postgresql+asyncpg://usp_writer:<口令>@localhost:5432/cmc_analytics

# 走 SSH 隧道读 Linux 全量真数据时（一条隧道服务两个库）：
#   ssh -N -L 15432:localhost:5432 -p 13568 prometheus@172.19.0.105
#   把上面两行的 localhost:5432 改成 localhost:15432 即可。

APP_ENV=dev
# 前端开发地址，逗号分隔，用于 CORS
DEV_EXTRA_ORIGINS=http://localhost:5170

# ---- 统一认证（MDM Portal，规范见 ~/code/CLAUDE.md §8）----
# 本地开发可全部留空 = 开放模式（不用登录）。生产（Linux）必须配齐以下三项：
# MDM 后端地址（Linux 上是本机 cmab-backend 服务）
MDM_BASE_URL=
# 验签密钥：HS256 时必须与 MDM 后端 .env 的 SECRET_KEY 逐字符一致
JWT_SECRET_KEY=
# 生产设 true：漏配验签密钥则启动报错，防止裸奔上线
AUTH_REQUIRED=false
# 允许查看的角色码（默认已含 SYS_ADMIN 与三个 USP 角色，一般不用改）
# VIEWER_ROLES=SYS_ADMIN,CMC_USP_RESEARCHER,CMC_USP_MANAGER,CMC_USP_OPERATOR
