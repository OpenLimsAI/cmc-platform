# ========== 数据库连接 ==========
# 单库 cmc_analytics，两个角色：
#   - 看板只读 cmc_analytics.mart.*（lims_reader）
#   - admin 面板读写 cmc_analytics.mdm.{personnel,test_method}（lims_mdm_writer，SELECT/INSERT/UPDATE）

# 分析层只读账号（看板所有 dashboard 端点用）
ANALYTICS_DATABASE_URL=postgresql+asyncpg://lims_reader:dev_lims_2026@localhost:5432/cmc_analytics

# MDM 写账号（/api/v1/admin/* 端点用）。同库 cmc_analytics，schema=mdm。
# 为空时回落到 ANALYTICS_DATABASE_URL（但 lims_reader 没有写权限，会 permission denied）。
MDM_DATABASE_URL=postgresql+asyncpg://lims_mdm_writer:dev_lims_mdm_2026@localhost:5432/cmc_analytics

# Raw 库只读（仅 data-freshness 用，查 cmc_rd.meta.etl_run）。可留空，端点会优雅降级。
RAW_DATABASE_URL=postgresql+asyncpg://lims_reader:dev_lims_2026@localhost:5432/cmc_rd

# 管理面板登录密码（生产环境必须改为强随机密码）
ADMIN_PASSWORD=admin_lims_2026

# ========== 应用配置 ==========
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 额外允许的 CORS 来源（逗号分隔）。http://localhost:3000 始终允许，无需添加。
# 从其他主机访问（VM、内网 IP）时用这个配。
# 示例：DEV_EXTRA_ORIGINS=http://192.168.1.100:3000,http://10.0.0.5:3000
DEV_EXTRA_ORIGINS=
