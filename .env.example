# =============================================================================
# 文件: .env.example
# 用途: 环境变量样例(复制为 .env 后按需修改,.env 不进 git)。
#       - Linux 生产: systemd 用 EnvironmentFile=/opt/cmc-labops/.env 加载
#       - Mac 开发:   LaunchAgent 启动脚本 source 项目根 .env
#       格式必须严格 KEY=VALUE,不要加引号、不要带空格。
# =============================================================================

# ---- 端口(本项目固定为编号 10;改了请同步 ~/code/PORTS.md) ----
# 后端 FastAPI 8010 / 前端 React(Vite/vite preview)5110
BACKEND_PORT=8010
FRONTEND_PORT=5110

# ---- 后端连库 ----
# cmc_user 由 postgres 一次性创建,只能动 material_mgmt / equipment_mgmt schema
DATABASE_URL=postgresql://cmc_user:<your-password>@127.0.0.1:5432/cmc_data_platform

# ---- 前端 -> 后端 ----
# 注意:这里端口必须与 BACKEND_PORT 保持一致(systemd 不会自动展开)
API_BASE_URL=http://localhost:8010

# ---- MDM Portal(v2.0 起认证与物料/设备主数据引用都依赖它) ----
MDM_BASE_URL=http://127.0.0.1:18000/api/v1
MDM_TIMEOUT=5
# JWT 本地校验密钥,必须与 MDM 后端的 SECRET_KEY 一致
MDM_SECRET_KEY=<must-match-mdm-backend-secret-key>
MDM_JWT_ALGORITHM=HS256
# LabOps 准入部门前缀（MDM auth.user.department 以此开头才能用；SYS_ADMIN 例外），逗号分隔
LAB_DEPARTMENT_PREFIXES=TT,CMC
