# =============================================================================
# 文件: .env.example
# 用途: 部署在 Linux 服务器时的环境变量样例。
#       systemd 用 EnvironmentFile=/opt/cmc-inventory/.env 直接加载本文件。
#       格式必须严格 KEY=VALUE,不要加引号、不要带空格。
# =============================================================================

# ---- 端口(若被占用,自由改) ----
BACKEND_PORT=8000
FRONTEND_PORT=8501

# ---- 后端连库 ----
# cmc_user 由 postgres 一次性创建,只能动 material_mgmt schema
DATABASE_URL=postgresql://cmc_user:CmcMvp2026!Strong@127.0.0.1:5432/cmc_data_platform

# ---- 前端 -> 后端 ----
# 注意:这里端口必须与 BACKEND_PORT 保持一致(systemd 不会自动展开)
API_BASE_URL=http://localhost:8000
