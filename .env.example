# =============================================================================
# 文件: .env.example
# 用途: 环境变量样例。复制为 .env 并按需修改。
#
# 主用法(默认 docker-compose.yml,复用宿主机已有 PG):
#   - 只需关注 DATABASE_URL,host 用 host.docker.internal
#   - PG_USER / PG_PASSWORD / PG_DB 仅用于备选方案 docker-compose.with-pg.yml
# =============================================================================

# 后端连接到宿主机 PG
# 注意:host.docker.internal 在 docker-compose.yml 中已通过 extra_hosts 注入
DATABASE_URL=postgresql://cmc_user:change_me@host.docker.internal:5432/cmc_inventory

# 前端 → 后端
API_BASE_URL=http://backend:8000

# ---- 仅当使用 docker-compose.with-pg.yml(容器内 PG)时需要 ----
PG_USER=cmc_user
PG_PASSWORD=change_me
PG_DB=cmc_inventory
