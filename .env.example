# =============================================================================
# 文件: .env.example
# 用途: 环境变量样例。复制为 .env 并修改密码后启动。
#
# 默认部署模式(docker-compose.yml):
#   - backend / frontend 都跑在 network_mode: host
#   - backend 通过 127.0.0.1 直连宿主机 PG
#   - 数据库共享:在已有 cmc_data_platform 库里加 material_mgmt schema
# =============================================================================

# 后端连接到宿主机 PG(network_mode: host 下用 127.0.0.1)
# cmc_user 由 postgres 一次性创建,只能动 material_mgmt schema
DATABASE_URL=postgresql://cmc_user:CmcMvp2026!Strong@127.0.0.1:5432/cmc_data_platform

# 前端 → 后端(host 网络下走 localhost)
API_BASE_URL=http://localhost:8000

# ---- 仅当用 docker-compose.with-pg.yml(容器内 PG)时需要 ----
PG_USER=cmc_user
PG_PASSWORD=CmcMvp2026!Strong
PG_DB=cmc_inventory
