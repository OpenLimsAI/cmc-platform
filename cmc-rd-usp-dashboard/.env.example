# 复制本文件为 .env 填真实值；.env 不进 git。
#
# 只读连接到 cmc_rd。Mac 本地开发先开 SSH 隧道把 Linux 的 5432 映射到本地 15432：
#   ssh -N -L 15432:localhost:5432 -p 13568 prometheus@172.19.0.105
# 然后用只读账号（别用 ETL 写账号 lucullus_etl）：
RAW_DATABASE_URL=postgresql+asyncpg://<只读账号>:<口令>@localhost:15432/cmc_rd

APP_ENV=dev
# 前端开发地址（CORS 白名单），逗号分隔
DEV_EXTRA_ORIGINS=http://localhost:5170
