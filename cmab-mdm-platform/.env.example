# ============================================================
# CMAB MDM Portal - 环境变量配置
# 复制为 .env 并按需修改
# ============================================================

# ----------- 应用 -----------
APP_NAME=CMAB MDM Portal
APP_ENV=development                       # development / test / production
APP_DEBUG=true
APP_LOG_LEVEL=INFO                        # DEBUG / INFO / WARNING / ERROR
APP_TIMEZONE=Asia/Shanghai

# 服务端口
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ----------- 安全 -----------
# ⚠️ 生产环境必须改为强随机字符串，建议 openssl rand -hex 32
SECRET_KEY=__REDACTED_SECRET_KEY__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS（开发时允许前端 dev server）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------- 数据库 -----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cmab_mdm
POSTGRES_USER=cmab_app
POSTGRES_PASSWORD=__REDACTED_POSTGRES_PASSWORD__
POSTGRES_DBA_USER=postgres
POSTGRES_DBA_PASSWORD=__REDACTED_POSTGRES_DBA_PASSWORD__

# 完整数据库 URL（应用使用）
DATABASE_URL=postgresql+asyncpg://cmab_app:__REDACTED_POSTGRES_PASSWORD__@postgres:5432/cmab_mdm

# 同步 URL（Alembic 使用）
DATABASE_URL_SYNC=postgresql://cmab_app:__REDACTED_POSTGRES_PASSWORD__@postgres:5432/cmab_mdm

# 连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ----------- Redis -----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ----------- 前端 -----------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=CMAB MDM Portal
# MDM -> PM reference verification: disabled until an approved PM identity is supplied.
PM_PUBLIC_URL=
PM_REFERENCE_API_URL=
PM_REFERENCE_ACCESS_TOKEN=

# MDM-only OIDC is opt-in; native password recovery/signature semantics remain.
MDM_OIDC_ENABLED=false
MDM_NATIVE_LOGIN_ENABLED=true
MDM_PUBLIC_URL=
MDM_OIDC_ISSUER_URL=
MDM_OIDC_INTERNAL_URL=
# Fixed Casdoor organization; never infer it from names or token display fields.
MDM_OIDC_ORGANIZATION=
# Enable only after verifying isForbidden/isDeleted are Self/Public visible in
# this organization and an existing session is denied after real account disable.
# Casdoor Admin-only AccountItems may mask a true status as false. This flag is
# a deployment confirmation, not automatic proof and not business role sync.
MDM_OIDC_ACCOUNT_STATUS_VISIBLE=false
MDM_OIDC_CLIENT_ID=
MDM_OIDC_CLIENT_SECRET=
MDM_OIDC_PM_CLIENT_ID=
MDM_OIDC_PM_CLIENT_SECRET=
MDM_OIDC_SESSION_MAX_SECONDS=3600
# Fresh signing uses its own authorization-code audience; password never enters MDM.
MDM_SIGNATURE_MODE=local_password
MDM_OIDC_SIGNATURE_CLIENT_ID=
MDM_OIDC_SIGNATURE_CLIENT_SECRET=
# Opt in only after the independent signature client's official UI is configured.
MDM_OIDC_SIGNATURE_PASSWORD_ONLY=false
# Separate user-delegated PM integration target. No machine writer by default.
MDM_PM_API_URL=
MDM_PM_SOURCE_ID=mdm
