[Unit]
Description=CMC Quality Analytics Platform backend (FastAPI :8040)
After=network.target postgresql.service

[Service]
User=prometheus
WorkingDirectory=/opt/cmc-quality-analytics-platform/backend
ExecStart=/home/prometheus/.local/bin/uv run --locked uvicorn app.main:app --host 127.0.0.1 --port 8040 --workers 2
Restart=always
RestartSec=5
Environment=LANG=en_US.UTF-8

[Install]
WantedBy=multi-user.target
