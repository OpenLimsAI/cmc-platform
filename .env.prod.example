# CMAB MDM Portal 生产环境变量（P4.B-5）
#
# 用法：cp .env.prod.example .env.prod && vim .env.prod
# 部署前 IT/SecOps 走密码管理流程；所有 _CHANGE_ME 必须替换
#
# 关联：deploy/docker-compose.prod.yml

# ---------- PostgreSQL ----------
POSTGRES_DB=cmab_mdm
POSTGRES_DBA_USER=postgres
POSTGRES_DBA_PASSWORD=CHANGE_ME_strong_dba_pwd
POSTGRES_USER=cmab_app
POSTGRES_PASSWORD=CHANGE_ME_strong_app_pwd

# ---------- 应用 ----------
# `openssl rand -base64 48`
SECRET_KEY=CHANGE_ME_at_least_32_chars_use_openssl_rand
APP_LOG_LEVEL=INFO

# CORS：填实际访问的前端域名（HTTPS 必填，不能用通配符）
CORS_ORIGINS=https://mdm.cmab.example.com

# ---------- 网关 ----------
HTTP_PORT=80
HTTPS_PORT=443
# 证书目录：放 fullchain.pem + privkey.pem
TLS_CERT_DIR=./deploy/nginx/certs

# ---------- 备份 ----------
# host 侧目录，docker-compose 把它挂到 postgres 容器 /backups
# host crond 跑 scripts/backup_db.sh 写入
BACKUP_DIR=/var/lib/cmab-mdm/backups
