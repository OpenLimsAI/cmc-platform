# =============================================================================
# 文件: .gitignore
# 用途: 忽略环境变量、Python 缓存、IDE 文件等
# =============================================================================

# 环境变量(.env.example 需要进库,显式排除在 ignore 之外)
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE
.idea/
.vscode/
.claude/

# OS
.DS_Store
Thumbs.db

# Mac 调试时本地重定向出来的日志(Linux 走 journald)
logs/

# Node / React 前端构建产物
node_modules/
frontend-react/dist/
frontend-react/.env.local
*.tsbuildinfo
