APP_ENV=mac_dev
DATABASE_URL=postgresql+asyncpg://lims_reader:CHANGE_ME@127.0.0.1:5432/cmc_analytics
JWT_ALGORITHM=HS256
JWT_VERIFY_KEY=CHANGE_ME
WATER_VIEW_ROLES=CMC_WATER_VIEWER,CMC_WATER_EXPORTER,SYS_ADMIN
WATER_EXPORT_ROLES=CMC_WATER_EXPORTER,SYS_ADMIN
PNG_FONT_PATH=/System/Library/Fonts/STHeiti Light.ttc

# 核实 staging 装载来源后填写；raw 同步不代表分析层已刷新
STAGING_DATA_ORIGIN=unverified
