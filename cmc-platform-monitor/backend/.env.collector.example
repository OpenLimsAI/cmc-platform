# Protected Linux collector environment, separate from API. No MDM signing secret.
OPS_MODE=production
OPS_COMPONENT=collector
OPS_DATABASE_URL=postgresql+asyncpg://ops_monitor_collector:CHANGE_ME@127.0.0.1:5432/cmc_analytics
OPS_RD_READ_URL=postgresql+asyncpg://ops_monitor_reader:CHANGE_ME@127.0.0.1:5432/cmc_rd
OPS_GMP_READ_URL=postgresql+asyncpg://ops_monitor_reader:CHANGE_ME@127.0.0.1:5434/cmc_gmp
# Verify actual instances/ports/credentials before using these placeholders.
OPS_CRON_SCHEDULE_PATH=/var/lib/cmc-platform-monitor/schedule-source/crontab.json
OPS_JOURNAL_SOCKET_PATH=/run/cmc-platform-monitor-evidence/journal.sock
