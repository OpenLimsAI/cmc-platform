[Unit]
Description=Completion hint for heartbeat-check.service
[Service]
Type=oneshot
User=flex2ingest
# Sender may only connect to the socket; no source database permissions.
SupplementaryGroups=opsmonitor-events
ExecStart=/usr/bin/python3 /opt/cmc-platform-monitor/scripts/notify_completion.py --task heartbeat-check
TimeoutStartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
