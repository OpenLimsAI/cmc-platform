<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.qingcheng.cmc-lims.backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/qingcheng/.local/bin/uv</string>
        <string>run</string>
        <string>uvicorn</string>
        <string>app.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8001</string>
        <string>--reload</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/qingcheng/code/cmc-rd-lims-dashboard/backend</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/qingcheng/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/qingcheng/Library/Logs/cmc-rd-lims-dashboard/backend.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/qingcheng/Library/Logs/cmc-rd-lims-dashboard/backend.err.log</string>
</dict>
</plist>
